{
  "$description": "Indian Print Maximalism. Project token format: named groups of $type/$value tokens; dimension values are rem strings. Palettes reference base colors. No root font-size override.",
  "color": {
    "mango": { "$type": "color", "$value": "#ffcc32" },
    "maroon": { "$type": "color", "$value": "#701c39" },
    "rani": { "$type": "color", "$value": "#e72b78" },
    "indigo": { "$type": "color", "$value": "#25216b" },
    "vermilion": { "$type": "color", "$value": "#ce2a24" },
    "paper": { "$type": "color", "$value": "#fff2cc" },
    "leaf": { "$type": "color", "$value": "#28654a" },
    "lime": { "$type": "color", "$value": "#d6e35c" },
    "ink": { "$type": "color", "$value": "#2a1424" },
    "gulabi": { "$type": "color", "$value": "#f4b6ca" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "'Teko', Impact, 'Arial Narrow', sans-serif" },
    "painted": { "$type": "fontFamily", "$value": "'Yatra One', Georgia, serif" },
    "body": { "$type": "fontFamily", "$value": "Arial, 'Noto Sans', 'Noto Sans Devanagari', sans-serif" },
    "label": { "$type": "fontFamily", "$value": "'Courier New', ui-monospace, monospace" }
  },
  "text": {
    "micro": { "$type": "dimension", "$value": "0.75rem" },
    "caption": { "$type": "dimension", "$value": "0.875rem" },
    "body": { "$type": "dimension", "$value": "1rem" },
    "lead": { "$type": "dimension", "$value": "1.125rem" },
    "subheading": { "$type": "dimension", "$value": "1.75rem" },
    "heading": { "$type": "dimension", "$value": "3rem" },
    "display": { "$type": "dimension", "$value": "10rem" }
  },
  "leading": {
    "display": { "$type": "number", "$value": 0.82 },
    "painted": { "$type": "number", "$value": 1.3 },
    "body": { "$type": "number", "$value": 1.6 },
    "label": { "$type": "number", "$value": 1.4 }
  },
  "tracking": {
    "display": { "$type": "dimension", "$value": "-0.125rem" },
    "label": { "$type": "dimension", "$value": "0.0875rem" }
  },
  "weight": {
    "regular": { "$type": "number", "$value": 400 },
    "bold": { "$type": "number", "$value": 700 }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "paper": { "$type": "dimension", "$value": "0.125rem" },
    "ticket": { "$type": "dimension", "$value": "0.375rem" }
  },
  "border": {
    "fine": { "$type": "dimension", "$value": "0.0625rem" },
    "ink": { "$type": "dimension", "$value": "0.125rem" },
    "frame": { "$type": "dimension", "$value": "0.25rem" }
  },
  "layout": {
    "max": { "$type": "dimension", "$value": "90rem" },
    "reading": { "$type": "dimension", "$value": "42rem" },
    "touch": { "$type": "dimension", "$value": "2.75rem" }
  },
  "shadow": {
    "ticket": { "$type": "string", "$value": "0.25rem 0.25rem 0 var(--ipm-extrusion)" },
    "panel": { "$type": "string", "$value": "0.5rem 0.5rem 0 var(--ipm-extrusion)" }
  },
  "duration": {
    "press": { "$type": "duration", "$value": "0.18s" },
    "ink": { "$type": "duration", "$value": "0.22s" },
    "reveal": { "$type": "duration", "$value": "0.75s" }
  },
  "palettes": {
    "mango": { "canvas": "{color.mango}", "ink": "{color.maroon}", "face": "{color.maroon}", "keyline": "{color.paper}", "extrusion": "{color.maroon}", "accent": "{color.rani}", "panel": "{color.paper}", "panel-ink": "{color.ink}" },
    "indigo": { "canvas": "{color.indigo}", "ink": "{color.paper}", "face": "{color.mango}", "keyline": "{color.ink}", "extrusion": "{color.rani}", "accent": "{color.mango}", "panel": "{color.paper}", "panel-ink": "{color.indigo}" },
    "gulabi": { "canvas": "{color.gulabi}", "ink": "{color.indigo}", "face": "{color.indigo}", "keyline": "{color.paper}", "extrusion": "{color.maroon}", "accent": "{color.maroon}", "panel": "{color.paper}", "panel-ink": "{color.ink}" }
  }
}
