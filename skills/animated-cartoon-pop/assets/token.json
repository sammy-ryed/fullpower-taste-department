    "ink-black": {
      "$value": "#1a1a1a",
      "$type": "color",
      "$description": "Ink Black — Body text, primary borders, and outlined button strokes — the near-black that does typographic work on cream surfaces"
    },
    "pure-black": {
      "$value": "#000000",
      "$type": "color",
      "$description": "Pure Black — Hard borders, icons, and text on yellow surfaces — pure black where maximum edge contrast is needed"
    }
  },
  "font": {
    "obviouslyvariable": {
      "$value": "ObviouslyVariable",
      "$type": "fontFamily",
      "$description": "Display and large heading family — the only font loud enough for the system. Sizes scale from 1.125rem body uses up to 21.3125rem poster-scale display. Tight 0.80–1.00 leading makes multi-line headlines stack into solid color blocks; calt is disabled so the wide geometric forms stay unornamented. Substitute: Founders Grotesk Condensed, Knockout, or Druk Wide."
    },
    "degularvariable": {
      "$value": "DegularVariable",
      "$type": "fontFamily",
      "$description": "Ultra-small UI text — nav, footer micro-copy, and inline labels at 0.625rem. The neutral workhorse that disappears next to the display voice. Substitute: Inter, IBM Plex Sans."
    },
    "bergenmonoregular": {
      "$value": "bergen_monoregular",
      "$type": "fontFamily",
      "$description": "Monospaced micro-type for nav, tags, and small data labels — provides a typewriter rhythm against the rounded display. The 0.80 leading on monospace is signature: mono stacked tight feels like a receipt. Substitute: JetBrains Mono, IBM Plex Mono."
    },
    "degulardisplay-bold": {
      "$value": "DegularDisplay-Bold",
      "$type": "fontFamily",
      "$description": "Small bold body text for CTAs, button labels, and emphasized micro-copy. The 0.05em tracking opens the letterforms enough to read at 1rem without crowding. Substitute: Degular Bold, Söhne Bold."
    }
  },
